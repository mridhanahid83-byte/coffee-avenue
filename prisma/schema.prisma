generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ACCESS CONTROL
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Super Admin, Head of Operations, Manager, Team Lead, Employee, Intern, ...
  slug        String   @unique // super_admin, head_of_operations, ...
  description String?
  isSystem    Boolean  @default(false) // seeded default roles cannot be deleted
  permissions Json     @default("[]") // array of permission keys, admin editable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("roles")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  tasks     Task[]

  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────
// EMPLOYEES (also the auth-bearing "user" of the system)
// ─────────────────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
  INTERN
  FREELANCER
  OTHER
}

model Employee {
  id                 String  @id @default(cuid())
  fullName           String
  email              String  @unique
  phone              String?
  profilePhotoUrl    String?
  passwordHash       String
  mustChangePassword Boolean @default(true)

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  employeeType EmployeeType   @default(FULL_TIME)
  joiningDate  DateTime?
  status       EmployeeStatus @default(ACTIVE)
  notes        String?

  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  teamLeadId  String?
  teamLead    Employee?  @relation("EmployeeTeamLead", fields: [teamLeadId], references: [id])
  teamMembers Employee[] @relation("EmployeeTeamLead")

  deactivatedAt DateTime?
  lastLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  attendances           Attendance[]      @relation("AttendanceEmployee")
  attendanceCorrections Attendance[]      @relation("AttendanceCorrectedBy")
  leaves                Leave[]           @relation("LeaveEmployee")
  leaveReviews          Leave[]           @relation("LeaveReviewer")
  clientTeams           ClientTeam[]
  clientsAsCS           Client[]          @relation("ClientAssignedCS")
  tasksAssigned         Task[]            @relation("TaskAssignee")
  tasksCreated          Task[]            @relation("TaskAssignedBy")
  tasksReviewed         Task[]            @relation("TaskReviewer")
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  taskActivities        TaskActivity[]
  contentItems          ContentItem[]
  campaigns             Campaign[]
  notifications         Notification[]
  performanceNotesFor   PerformanceNote[] @relation("PerformanceSubject")
  performanceNotesBy    PerformanceNote[] @relation("PerformanceAuthor")
  activityLogs          ActivityLog[]

  @@index([status])
  @@index([departmentId])
  @@index([roleId])
  @@index([managerId])
  @@index([teamLeadId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────
// ATTENDANCE / LEAVE / HOLIDAYS
// ─────────────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HALF_DAY
  HOLIDAY
}

model Attendance {
  id                     String           @id @default(cuid())
  employeeId             String
  employee               Employee         @relation("AttendanceEmployee", fields: [employeeId], references: [id])
  date                   DateTime         @db.Date
  checkInAt              DateTime?
  checkOutAt             DateTime?
  status                 AttendanceStatus @default(PRESENT)
  lateMinutes            Int              @default(0)
  workingMinutes         Int?
  flaggedMissingCheckout Boolean          @default(false)

  correctedById  String?
  correctedBy    Employee? @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id])
  correctionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model LeaveType {
  id        String   @id @default(cuid())
  name      String   @unique
  isPaid    Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leaves Leave[]

  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation("LeaveEmployee", fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      String?
  status      LeaveStatus @default(PENDING)

  reviewedById String?
  reviewedBy   Employee? @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@unique([date])
  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────────────────────────────────

enum ClientStatus {
  LEAD
  PROPOSAL
  ONBOARDING
  ACTIVE
  PAUSED
  COMPLETED
  LOST
  ARCHIVED
}

model Client {
  id            String       @id @default(cuid())
  clientName    String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  facebook      String?
  instagram     String?
  industry      String?
  services      String?
  packageName   String?
  monthlyFee    Decimal?     @db.Decimal(12, 2)
  startDate     DateTime?    @db.Date
  renewalDate   DateTime?    @db.Date
  notes         String?
  status        ClientStatus @default(LEAD)

  assignedCsId String?
  assignedCs   Employee? @relation("ClientAssignedCS", fields: [assignedCsId], references: [id])

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  team      ClientTeam[]
  tasks     Task[]
  content   ContentItem[]
  campaigns Campaign[]

  @@index([status])
  @@map("clients")
}

enum ClientTeamRole {
  CS
  DESIGNER
  DIGITAL_MARKETER
  DEVELOPER
  OTHER
}

model ClientTeam {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  role       ClientTeamRole @default(OTHER)
  createdAt  DateTime       @default(now())

  @@unique([clientId, employeeId, role])
  @@index([clientId])
  @@index([employeeId])
  @@map("client_team")
}

// ─────────────────────────────────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  assignedById String?
  assignedBy   Employee? @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  reviewerId String?
  reviewer   Employee? @relation("TaskReviewer", fields: [reviewerId], references: [id])

  priority       TaskPriority   @default(MEDIUM)
  status         TaskStatus     @default(NOT_STARTED)
  approvalStatus ApprovalStatus @default(NOT_SUBMITTED)

  contentType   String? // Static, Carousel, Template, Reel, Motion, Story, Banner, Other (design board)
  brief         String?
  referenceLink String?
  deliveryLink  String?

  requiresReview Boolean @default(true)

  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]
  activities  TaskActivity[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([clientId])
  @@index([departmentId])
  @@index([deadline])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileUrl      String
  fileSize     Int?
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

model TaskActivity {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     Employee? @relation(fields: [actorId], references: [id])
  action    String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@map("task_activity")
}

// ─────────────────────────────────────────────────────────────────────────
// CONTENT DELIVERY
// ─────────────────────────────────────────────────────────────────────────

enum ContentStage {
  BRIEF
  COPY
  DESIGN
  INTERNAL_REVIEW
  CLIENT_APPROVAL
  REVISION
  APPROVED
  PUBLISHED
}

model ContentItem {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  title       String
  contentType String // Static, Carousel, Template, Reel, Motion, Story, Banner, Other

  stage ContentStage @default(BRIEF)

  copyStatus       String?
  designStatus     String?
  internalReview   String?
  clientApproval   String?
  revisionNotes    String?
  publishingStatus String?

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  deadline      DateTime?
  publishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([stage])
  @@map("content_items")
}

// ─────────────────────────────────────────────────────────────────────────
// CAMPAIGNS
// ─────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  name      String
  platform  String?
  objective String?
  budget    Decimal?  @db.Decimal(12, 2)
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  responsibleId String?
  responsible   Employee? @relation(fields: [responsibleId], references: [id])

  status     CampaignStatus @default(PLANNED)
  notes      String?
  reportLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / PERFORMANCE / ACTIVITY LOG
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String
  title      String
  message    String
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
  @@map("notifications")
}

model PerformanceNote {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("PerformanceSubject", fields: [employeeId], references: [id])
  authorId   String
  author     Employee @relation("PerformanceAuthor", fields: [authorId], references: [id])
  note       String
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("performance_notes")
}

model ActivityLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       Employee? @relation(fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// tracks whether the first Super Admin setup has been completed
model SystemState {
  id            Int      @id @default(1)
  setupComplete Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("system_state")
}
