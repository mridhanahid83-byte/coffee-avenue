# For Neon, use the "Pooled connection" string from your Neon project dashboard
# (hostname contains "-pooler"); it already includes ?sslmode=require.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# Only needed for local dev / non-Vercel hosting. On Vercel, trustHost is
# enabled and the deployment URL is detected automatically.
NEXTAUTH_URL="http://localhost:3000"

# Optional: only required for the Voice Channels feature (live audio/video +
# screen share). Sign up free at https://livekit.io, create a project, and
# copy these from its dashboard. Without them, Voice Channels still lets
# admins create channels but shows a "not configured" message when joining.
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://your-project-xxxxxx.livekit.cloud"
